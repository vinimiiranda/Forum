# Copie este arquivo para .env e preencha os valores.
# O .env nao deve ser commitado.

# Banco de dados
DB_URL=jdbc:mysql://localhost:3306/forum_hub?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# Segredo usado para assinar os tokens JWT (use uma string longa e aleatoria)
JWT_SECRET=

# Envio de e-mail (verificacao de conta)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Login social
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
